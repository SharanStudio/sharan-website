---
import '../styles/global.css';
import { getData, usingSample } from '../lib/data.js';
const { title, description = '', page = '' } = Astro.props;
const d = await getData();
const s = d.site_settings[0] || {};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [['Teams', '/teams/'], ['Projects', '/projects/'], ['Publications', '/publications/'], ['Recognitions', '/recognitions/'], ['Photos', '/photos/'], ['Collaborate', '/collaborate/']];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title ? `${title} | ${s.name}` : s.name}</title>
  <meta name="description" content={description || s.subline || ''} />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,600;1,500;1,600&family=Inter:wght@400;600&display=swap" rel="stylesheet" />
</head>
<body>
  {usingSample && <div class="banner">Preview with sample data. Real content appears once the site connects to Supabase.</div>}
  <header class="nav"><div class="wrap">
    <a class="brand" href={`${base}/`}>{s.name}</a>
    <nav aria-label="Main"><ul>{nav.map(([label, href]) => <li><a href={`${base}${href}`} aria-current={page === label ? 'page' : undefined}>{label}</a></li>)}</ul></nav>
  </div></header>
  <slot />
  <footer><div class="wrap foot">
    <div>
      <h2 class="fh">Contact me</h2>
      <p class="social">
        {s.linkedin_url && <a href={s.linkedin_url} aria-label="LinkedIn"><svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M20.4 20.5h-3.6v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H9.3V9h3.4v1.6c.5-.9 1.6-1.8 3.4-1.8 3.6 0 4.3 2.4 4.3 5.5v6.2zM5.3 7.4a2.1 2.1 0 1 1 0-4.1 2.1 2.1 0 0 1 0 4.1zM7.1 20.5H3.6V9h3.5v11.5z"/></svg></a>}
        {s.instagram_url && <a href={s.instagram_url} aria-label="Instagram"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg></a>}
        {s.x_url && <a href={s.x_url} aria-label="X (Twitter)"><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.3L5.3 21H2.2l7.2-8.3L1.8 3h6.4l4.4 5.8L17.8 3zm-1.1 16.2h1.7L7.3 4.7H5.5l11.2 14.5z"/></svg></a>}
      </p>
    </div>
    <div>
      <h2 class="fh">Write to me at:</h2>
      <p class="mails">{(s.contact_emails || []).map((e) => <a href={`mailto:${e}`}>{e}</a>)}</p>
    </div>
  </div>
  <div class="wrap legal">© {new Date().getFullYear()} {s.name}. All rights reserved.</div></footer>
</body>
</html>
